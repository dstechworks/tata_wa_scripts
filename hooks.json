[
    {
        "id": "deploy",
        "execute-command": "/bin/sh",
        "command-working-directory": "/tmp",
        "command-arguments": [
            "-c",
            "echo '🚨 Webhook triggered at $(date)' >> /tmp/webhook.log && echo 'Token: $TOKEN' >> /tmp/webhook.log && /root/tata_wa_scripts/deploy.sh"
        ],
        "response-message": "Deploy script executed",
        "trigger-rule": {
            "match": {
                "type": "value",
                "value": "TECHWORKS_SECRET_KEY",
                "parameter": {
                    "source": "url",
                    "name": "token"
                }
            }
        }
    }
]