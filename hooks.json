[
    {
        "id": "deploy",
        "execute-command": "/bin/sh",
        "command-working-directory": "/root/tata_wa_scripts",
        "command-arguments": [
            "-c",
            "echo '🎯 WEBHOOK FIRED: $(date)' >> /tmp/webhook.log && echo 'Ref: $REF | Event: $EVENT' >> /tmp/webhook.log && if [ \"$REF\" = \"refs/heads/production\" ]; then echo '✅ Deploying production...' >> /tmp/webhook.log && ./deploy.sh >> /tmp/deploy.log 2>&1 && echo '🟢 Deploy finished' >> /tmp/webhook.log; else echo '🟨 Skipped: $REF' >> /tmp/webhook.log; fi"
        ],
        "response-message": "Webhook processed",
        "include-command-output-in-response": true,
        "pass-environment-to-command": [
            {
                "source": "payload",
                "name": "ref",
                "target": "REF"
            },
            {
                "source": "headers",
                "name": "X-GitHub-Event",
                "target": "EVENT"
            }
        ],
        "trigger-rule": {
            "and": [
                {
                    "equal": {
                        "string": "{{payload.ref}}",
                        "value": "refs/heads/production"
                    }
                },
                {
                    "equal": {
                        "string": "{{headers.X-GitHub-Event}}",
                        "value": "push"
                    }
                }
            ]
        }
    }
]